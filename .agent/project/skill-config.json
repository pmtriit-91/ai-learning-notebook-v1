{
  "version": "7.0",
  "profile": "V7 IDE-Native OS Ready",
  "allow_optional_pack": false,
  "allowed_optional_skills": [
    "coding-standards",
    "verification-loop",
    "security-review",
    "test-driven-development",
    "deep-research"
  ],
  "creative_default": "lite",
  "reviewer_default": "lite",
  "optional_loading": {
    "strategy": "fetch_single_skill",
    "tool": "_tools/optional_skill_fetcher.py",
    "never_extract_full_vendor_pack": true
  },
  "runtime": {
    "use_preflight": true,
    "preflight_tool": "_tools/v7_preflight.py",
    "use_mode_checker": true,
    "use_telemetry": true,
    "telemetry_for_fast_tasks": false,
    "telemetry_for_standard_deep_tasks": true,
    "hard_interception_requires_ide_wrapper": true
  },
  "external_memory": {
    "agentmemory_in_core": false,
    "user_controlled_recall_only": true,
    "source_code_over_memory": true
  },
  "design_intelligence": {
    "default": "adaptive",
    "do_not_force_style": true,
    "detect_project_intent_first": true,
    "ui_library_neutral": true,
    "style_memory_is_guidance_not_authority": true
  }
}
