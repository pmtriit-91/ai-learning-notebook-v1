{
  "version": "7.0",
  "name": "V7 IDE-Native OS Ready Capability Map",
  "source_of_truth": "core/runtime-kernel.md",
  "purpose": "Capability index for low-overhead orchestration. This is not a duplicate policy engine.",
  "wrapper_ready": true,
  "global": {
    "optional_skills_default": "off",
    "full_creative_default": "off",
    "dependency_safety": "inspect_nearest_dependency_layer_before_edit",
    "optional_skill_recursion": "forbidden_without_evidence_based_escalation",
    "telemetry": "tool_assisted",
    "hard_interception": "external_wrapper_required",
    "design_style_default": "detect_from_project_and_user_intent",
    "ui_library_bias": "forbidden",
    "style_imposition": "forbidden"
  },
  "modes": {
    "FAST": {
      "max_files": 6,
      "telemetry": "optional",
      "optional_skills": false
    },
    "STANDARD": {
      "max_files": 14,
      "telemetry": "recommended",
      "optional_skills": false
    },
    "DEEP": {
      "max_files": 40,
      "telemetry": "recommended",
      "optional_skills": "whitelist_only"
    }
  },
  "capabilities": {
    "fast_ui_fix": {
      "mode": "FAST",
      "triggers": [
        "text",
        "spacing",
        "color",
        "minor CSS",
        "simple responsive",
        "small import fix"
      ],
      "load": [
        "creative/creative-lite.md",
        "reviewers/review-lite.md"
      ],
      "checks": [
        "direct imports",
        "nearest dependency",
        "basic build/type if available"
      ]
    },
    "standard_feature": {
      "mode": "STANDARD",
      "triggers": [
        "new component",
        "medium feature",
        "API integration",
        "local refactor"
      ],
      "load": [
        "workflows/executor.md",
        "reviewers/review-lite.md",
        "safety/anti-refactor.md"
      ],
      "checks": [
        "direct dependencies",
        "component boundary",
        "no unrelated refactor"
      ]
    },
    "creative_ui": {
      "mode": "STANDARD",
      "triggers": [
        "premium UI",
        "layout polish",
        "less mechanical",
        "visual hierarchy",
        "responsive polish"
      ],
      "load": [
        "creative/creative-lite.md",
        "reviewers/creative-director-reviewer.md"
      ],
      "checks": [
        "visual hierarchy",
        "spacing",
        "brand consistency",
        "responsive"
      ]
    },
    "cinematic_experience": {
      "mode": "DEEP",
      "triggers": [
        "cinematic",
        "3D",
        "WebGL",
        "scroll choreography",
        "Awwwards",
        "Apple/Tesla/Porsche"
      ],
      "load": [
        "creative/cinematic-composition.md",
        "creative/motion-grammar.md",
        "creative/interactive-storytelling.md",
        "reviewers/motion-experience-reviewer.md"
      ],
      "checks": [
        "motion quality",
        "performance",
        "storytelling continuity",
        "responsive"
      ],
      "note": "Specialized path only when user/project explicitly requests cinematic/storytelling/3D/motion-heavy experience. Not a default design style."
    },
    "architecture_refactor": {
      "mode": "DEEP",
      "triggers": [
        "architecture",
        "large refactor",
        "system design",
        "multi-module",
        "dependency graph"
      ],
      "load": [
        "workflows/refactoring.md",
        "reviewers/architecture-reviewer.md",
        "safety/production-risk.md"
      ],
      "checks": [
        "api compatibility",
        "dependency graph",
        "backward compatibility",
        "build/test"
      ]
    },
    "security_review": {
      "mode": "DEEP",
      "triggers": [
        "security",
        "auth",
        "permission",
        "secret",
        "vulnerability"
      ],
      "load": [
        "safety/advanced-security-scan.md",
        "reviewers/final-checklist.md"
      ],
      "optional_skills": [
        "security-review"
      ],
      "checks": [
        "auth boundary",
        "secret exposure",
        "permission model"
      ]
    },
    "adaptive_design_ui": {
      "mode": "STANDARD",
      "triggers": [
        "UI polish",
        "UX polish",
        "style consistency",
        "visual hierarchy",
        "design feels generic",
        "design feels mechanical",
        "layout feels cramped",
        "interaction feels unclear",
        "improve visual quality"
      ],
      "load": [
        "creative/design-intent-runtime.md",
        "creative/style-coherence-review.md",
        "reviewers/review-lite.md"
      ],
      "checks": [
        "design intent match",
        "style coherence",
        "visual hierarchy",
        "spacing rhythm",
        "responsive behavior",
        "accessibility",
        "maintainability"
      ]
    }
  },
  "design_intelligence": {
    "principle": "Detect project design intent. Do not impose a specific aesthetic.",
    "style_specific_defaults": "forbidden",
    "ui_libraries": "implementation_details_not_visual_identity"
  }
}
